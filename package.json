{
  "name": "triggerkit",
  "version": "2.0.2",
  "description": "A plugin to connect SvelteKit functions to your trigger.dev tasks",
  "homepage": "triggerkit.pages.dev",
  "keywords": [
    "vite",
    "vite-plugin",
    "svelte",
    "sveltekit",
    "trigger.dev",
    "functions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnoughXP/vite-plugin-triggerkit.git"
  },
  "bugs": {
    "url": "https://github.com/EnoughXP/vite-plugin-triggerkit/issues"
  },
  "license": "MIT",
  "author": "Jason Gutierrez",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@trigger.dev/sdk": "^4.0.0",
    "@trigger.dev/build": "^4.0.0",
    "esbuild": ">=0.19.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@trigger.dev/build": "^4.8.1",
    "@trigger.dev/sdk": "^4.8.1",
    "@types/node": "^22.12.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "publint": "^0.3.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "svelte": "^5.0.0",
    "trigger.dev": "^4.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.6"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "build": "svelte-kit sync && vite build && npm run package",
    "package": "svelte-kit sync && svelte-package && publint && cp README.md dist/",
    "generate-virtual-types": "node scripts/generate-virtual-types.js",
    "changeset": "changeset",
    "dev": "svelte-kit sync && vite build --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "version": "changeset version",
    "release": "npm run package && changeset publish"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.23.1": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true,
    "@depot/cli@0.0.1-cli.2.80.0": true,
    "fsevents@2.3.3": true
  }
}
